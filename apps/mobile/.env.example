# LiftMate Mobile Environment Configuration

# Production API Endpoint (HTTPS required for release builds)
# Examples:
#   Remote Server:  https://api.liftmate.com
#   Local LAN Test: http://192.168.1.50:3000
EXPO_PUBLIC_API_URL=https://api.liftmate.com

# Fixture / Mock Data Flag
# Keep false so real backend data is used
EXPO_PUBLIC_USE_FIXTURES=false
