generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WeightUnit {
  kg
  lb
}

enum SetType {
  warmup
  working
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum WorkoutDuration {
  lt30
  d30_45 @map("30_45")
  d45_60 @map("45_60")
  d60_90 @map("60_90")
  gt90
}

enum TrainingLocation {
  commercial_gym
  home_gym
  home
  outdoor
}

enum Equipment {
  barbell
  dumbbell
  cable_machine
  smith_machine
  leg_press
  hack_squat
  pulldown_machine
  chest_press
  machines
  pull_up_bar
  resistance_bands
  bodyweight
  kettlebell
  other
}

enum MuscleGroup {
  chest
  back
  shoulders
  biceps
  triceps
  forearms
  quads
  hamstrings
  glutes
  calves
  abs
  traps
  lats
  full_body
}

enum MovementPattern {
  push
  pull
  squat
  hinge
  lunge
  carry
  rotation
  isolation
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum FitnessGoal {
  lose_fat
  build_muscle
  gain_strength
  general_fitness
  body_recomposition
}

enum WorkoutStatus {
  in_progress
  completed
  cancelled
}

enum ProgramStatus {
  active
  completed
  archived
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum FoodSource {
  verified
  custom
  tkpi
  open_food_facts
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name")
  dateOfBirth  DateTime?  @map("date_of_birth") @db.Date
  weightUnit   WeightUnit @default(kg) @map("weight_unit")
  timezone     String     @default("UTC")

  gender           Gender?
  heightCm         Float?            @map("height_cm")
  weightKg         Float?            @map("weight_kg")
  bodyFatPct       Float?            @map("body_fat_pct")
  targetWeightKg   Float?            @map("target_weight_kg")
  workoutDuration  WorkoutDuration?  @map("workout_duration")
  trainingLocation TrainingLocation? @map("training_location")

  onboardedAt DateTime? @map("onboarded_at")

  equipment           UserEquipment[]
  preferences         UserPreferences?
  workouts            Workout[]
  programs            Program[]
  foodLogs            FoodLog[]
  bodyWeightLogs      BodyWeightLog[]
  personalRecords     ExercisePersonalRecord[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("users")
}

model UserEquipment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  equipment Equipment

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, equipment])
  @@index([userId])
  @@map("user_equipment")
}

model UserPreferences {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  preferredEquipment Equipment[] @default([]) @map("preferred_equipment")
  preferredExercises String[]    @default([]) @map("preferred_exercises")
  avoidExercises     String[]    @default([]) @map("avoid_exercises")
  dietaryPreferences String[]    @default([]) @map("dietary_preferences")

  weeklyFrequency    Int?        @map("weekly_frequency")
  defaultRestSeconds Int         @default(120) @map("default_rest_seconds")

  primaryGoal     FitnessGoal? @map("primary_goal")
  secondaryGoal   FitnessGoal? @map("secondary_goal")
  experienceLevel Difficulty?  @map("experience_level")

  targetCalories Int? @map("target_calories")
  targetProtein  Int? @map("target_protein")
  targetCarbs    Int? @map("target_carbs")
  targetFat      Int? @map("target_fat")

  notificationsWorkoutReminder   Boolean @default(true) @map("notifications_workout_reminder")
  notificationsNutritionReminder Boolean @default(true) @map("notifications_nutrition_reminder")
  notificationsProgressReminder  Boolean @default(true) @map("notifications_progress_reminder")
  notificationsAiInsight         Boolean @default(true) @map("notifications_ai_insight")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("user_preferences")
}

model Exercise {
  id                 String          @id @default(uuid()) @db.Uuid
  name               String
  primaryMuscle      MuscleGroup     @map("primary_muscle")
  secondaryMuscles   MuscleGroup[]   @default([]) @map("secondary_muscles")
  equipment          Equipment
  movementPattern    MovementPattern @map("movement_pattern")
  difficulty         Difficulty
  instructions       String?
  externalId         String?         @unique @map("external_id")
  alternativeExercises String[]      @default([]) @map("alternative_exercises")

  workoutExercises WorkoutExercise[]
  programExercises ProgramExercise[]
  personalRecords  ExercisePersonalRecord[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([primaryMuscle])
  @@index([equipment])
  @@map("exercises")
}

model Workout {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  name        String?
  notes       String?       @map("notes")
  status      WorkoutStatus @default(completed) @map("status")
  programId   String?       @map("program_id") @db.Uuid
  startedAt   DateTime      @map("started_at")
  completedAt DateTime?     @map("completed_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  exercises WorkoutExercise[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@index([userId, startedAt])
  @@index([userId, status])
  @@map("workouts")
}

model WorkoutExercise {
  id         String @id @default(uuid()) @db.Uuid
  workoutId  String @map("workout_id") @db.Uuid
  exerciseId String @map("exercise_id") @db.Uuid
  position   Int

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id])
  sets     WorkoutSet[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([workoutId, position])
  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                String     @id @default(uuid()) @db.Uuid
  workoutExerciseId String     @map("workout_exercise_id") @db.Uuid
  position          Int
  setType           SetType    @default(working) @map("set_type")
  weight            Decimal    @db.Decimal(7, 2)
  weightUnit        WeightUnit @default(kg) @map("weight_unit")
  reps              Int
  rir               Int?
  rirUnknown        Boolean    @default(false) @map("rir_unknown")
  rpe               Decimal?   @db.Decimal(3, 1)
  restTime          Int?       @map("rest_time")
  notes             String?    @map("notes")
  completed         Boolean    @default(false)

  workoutExercise WorkoutExercise          @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  personalRecords ExercisePersonalRecord[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([workoutExerciseId, position])
  @@index([workoutExerciseId])
  @@map("workout_sets")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  deviceInfo String?   @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Program {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String?       @map("user_id") @db.Uuid
  name        String        @map("program_name")
  goal        FitnessGoal
  frequency   Int
  duration    String        @default("45_60")
  description String?
  status      ProgramStatus @default(active)

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  programExercises ProgramExercise[]
  workouts         Workout[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@index([status])
  @@map("programs")
}

model ProgramExercise {
  id          String  @id @default(uuid()) @db.Uuid
  programId   String  @map("program_id") @db.Uuid
  day         Int
  dayName     String? @map("day_name")
  exerciseId  String  @map("exercise_id") @db.Uuid
  sets        Int     @default(3)
  repMin      Int     @default(8) @map("rep_min")
  repMax      Int     @default(12) @map("rep_max")
  targetRir   Int?    @map("target_rir")
  restSeconds Int?    @map("rest_seconds")
  order       Int     @default(0)

  program  Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([programId, day])
  @@index([exerciseId])
  @@map("program_exercises")
}

model Food {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  servingSize    String     @map("serving_size")
  servingUnit    String     @default("g") @map("serving_unit")
  servingWeightG Float?     @map("serving_weight_g")
  calories       Decimal    @db.Decimal(7, 2)
  protein        Decimal    @db.Decimal(7, 2)
  carbs          Decimal    @db.Decimal(7, 2)
  fat            Decimal    @db.Decimal(7, 2)
  source         FoodSource @default(verified)
  barcode        String?    @unique
  externalId     String?    @unique @map("external_id")

  foodLogs FoodLog[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([name])
  @@index([source])
  @@index([deletedAt])
  @@map("foods")
}

model FoodLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  foodId      String?  @map("food_id") @db.Uuid
  foodName    String   @map("food_name")
  servingSize String   @map("serving_size")
  quantity    Decimal  @default(1.0) @db.Decimal(5, 2)
  mealType    MealType @map("meal_type")
  loggedAt    DateTime @map("logged_at")
  calories    Decimal  @db.Decimal(7, 2)
  protein     Decimal  @db.Decimal(7, 2)
  carbs       Decimal  @db.Decimal(7, 2)
  fat         Decimal  @db.Decimal(7, 2)
  source      String   @default("database")
  notes       String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@index([userId, loggedAt])
  @@index([userId, mealType])
  @@index([foodId])
  @@index([deletedAt])
  @@map("food_logs")
}

model BodyWeightLog {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  weightKg  Decimal   @map("weight_kg") @db.Decimal(5, 2)
  loggedAt  DateTime  @map("logged_at")
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, loggedAt])
  @@index([deletedAt])
  @@map("body_weight_logs")
}

model ExercisePersonalRecord {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  exerciseId      String      @map("exercise_id") @db.Uuid
  maxWeight       Decimal     @map("max_weight") @db.Decimal(7, 2)
  maxReps         Int         @map("max_reps")
  maxEstimated1Rm Decimal     @map("max_estimated_1rm") @db.Decimal(7, 2)
  achievedAt      DateTime    @map("achieved_at")
  workoutSetId    String?     @map("workout_set_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workoutSet WorkoutSet? @relation(fields: [workoutSetId], references: [id], onDelete: SetNull)

  @@unique([userId, exerciseId])
  @@index([userId])
  @@index([exerciseId])
  @@map("exercise_personal_records")
}
