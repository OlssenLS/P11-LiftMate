# Server Configuration
PORT=3000
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/liftmate?schema=public"

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins (e.g., https://app.liftmate.com,https://liftmate.app)
# Mobile native applications with no browser Origin header are always permitted.
CORS_ORIGIN="https://app.liftmate.com,http://localhost:8081"

# Authentication & JWT Secrets
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET="generate-a-strong-secret-key-for-access-token"
JWT_REFRESH_SECRET="generate-a-strong-secret-key-for-refresh-token"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Primary AI Provider: Groq (https://console.groq.com/keys)
# High-speed LLaMA 3.3 70B Versatile inference
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="llama-3.2-11b-vision-preview"

# Secondary / Backup AI Provider: Google AI Studio (https://aistudio.google.com/)
# Automatically activated if Groq is unavailable, rate-limited, or not configured
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-flash-latest"
